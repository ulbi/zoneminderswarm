    {
      "id": "claim_c0229ccecabe45d8ae3ede050867198e",
      "statement": "During the Docker build, the mlapi repository is cloned and its get_models.sh script runs to download YOLOv4-tiny object detection weights, OpenCV DNN face detector files, and the OpenFace nn4.small2.v1.t7 face embedding model into /usr/src/app/mlapi/.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L95-L105",
          "version": "repo-lines-v1:sha256:fe5ff766745ce003b1e3acafeb1be9bb7490ca99488be1b61abaad3cd20dc40c:"
        }
      ]
    },
    {
      "id": "claim_401fb0df1a264ae7aa362337b70c33be",
      "statement": "Model weights (YOLO, face detector, face embedding) are baked into the image layer at /usr/src/app/mlapi/ and are not stored in Docker volumes; updating them requires rebuilding the image.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L95-L105",
          "version": "repo-lines-v1:sha256:fe5ff766745ce003b1e3acafeb1be9bb7490ca99488be1b61abaad3cd20dc40c:"
        }
      ]
    },
    {
      "id": "claim_042e809158814e82b054034ce340d0d1",
      "statement": "Two Docker named volumes (known_faces, unknown_faces) are mounted into the zoneminder service at /var/lib/zmeventnotification/known_faces and /var/lib/zmeventnotification/unknown_faces respectively for persistent face recognition reference data; being named volumes, their contents persist across container recreation and image rebuilds.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L20-L57",
          "version": "repo-lines-v1:sha256:cc262ab7962e819c413cc17ec224184e029bb5bd0949050b1fdeddccfc8b9416:"
        }
      ]
    },
    {
      "id": "claim_b6a2e0f61d1b4712b8c6fcd1e87c5c13",
      "statement": "OpenCV 4.6.0 is pinned in the opencv_builder stage (ENV OPENCV_VERSION=4.6.0) and compiled with contrib modules for the face module; upgrading OpenCV requires rebuilding the builder stage and the full image.",
