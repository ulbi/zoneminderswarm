    {
      "id": "claim_a1e28443c6df486aac5b9e722984d1bf",
      "statement": "The entrypoint.sh script performs first-time initialization: seeds config from /org/etc/zm, sets timezone, waits for MariaDB, initializes database schema if empty, enables ZM_OPT_USE_EVENTNOTIFICATION, rewrites zm.conf and zmeventnotification.ini with env values, generates MLAPI_SECRET_KEY, and starts apache2 and zoneminder services.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L1-L128",
          "version": "repo-lines-v1:sha256:1d7b8edb05c2415b368854131c37c9c4786b6bff5da57df1ab73613558d868ea:"
        }
      ]
    },
    {
      "id": "claim_99a529dba4fb4dddbe0cef73a06d9c15",
      "statement": "Six named volumes persist data: db_data (MariaDB), zm_config (ZoneMinder config), zm_cache (ZoneMinder cache), known_faces, unknown_faces (face recognition), and mosquitto_data (MQTT persistence).",
