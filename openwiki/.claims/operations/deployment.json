    {
      "id": "claim_41c8a814a1e445ce823bd0ccc53d6df4",
      "statement": "The stack consists of three services: MariaDB (db), ZoneMinder (zoneminder), and Eclipse Mosquitto (eclipse-mosquitto), all connected via the zoneminder_network overlay network.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L1-L64",
          "version": "repo-lines-v1:sha256:c784a3df210ae4d63125ab022d859ea2ae57bf05f3dc385b0c4d642cfb9acf33:"
        }
      ]
    },
    {
      "id": "claim_d4c7cd2cb6024dd385f7c391f1afaf4c",
      "statement": "Host port mappings are defined in docker-compose.override.yml: 7080→80 and 7000→9000 for ZoneMinder; 1883→1883 and 9001→9001 for Mosquitto.",
      "evidence": [
        {
          "resource": "repo://docker-compose.override.yml#L1-L15",
          "version": "repo-lines-v1:sha256:7eecd1963b91cdb3d41ba9a43d6aea2203149b4a42492e2ec01b00456cdbc96b:"
