    {
      "id": "claim_dc7998af4366400e923e7d5e6e25f78e",
      "statement": "The zoneminder service receives the MariaDB credentials under ZoneMinder's own variable names, mapped from the MYSQL_* variables: ZM_DB_NAME=${MYSQL_DATABASE}, ZM_DB_USER=${MYSQL_USER}, ZM_DB_PASS=${MYSQL_PASSWORD}, with MYSQL_ROOT_PASSWORD passed through unchanged.",
