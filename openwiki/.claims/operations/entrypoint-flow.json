    {
      "id": "claim_8b36abf7b3b94e598c5521358c084a2d",
      "statement": "When MQTT_HOST is set, the entrypoint enables and populates the [mqtt] section of /etc/zm/zmeventnotification.ini (enable, server, username, password, retain=yes) and disables SSL in the [ssl] section using sed range addressing /\\[mqtt\\]/,/^\\[/ (and /\\[ssl\\]/,/^\\[/) between section headers; compose always supplies MQTT_HOST=eclipse-mosquitto, MQTT_USER, and MQTT_PASSWORD.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L23-L27",
          "version": "repo-lines-v1:sha256:6be46a65fc7dfb2dc0cdb4691864ddb2fcbd63dbfc53e09815b766060c822879:"
        },
