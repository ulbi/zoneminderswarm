    {
      "id": "claim_22e8545dc3e545c3900b74b023512728",
      "statement": "Database bootstrap checks table count via SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = '$ZM_DB_NAME'; if zero tables, it creates the database, user, grants via root, and imports /usr/share/zoneminder/db/zm_create.sql.",
