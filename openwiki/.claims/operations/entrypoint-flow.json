    {
      "id": "claim_360ddf401037405992f76d97c90a41e7",
      "statement": "The table-count bootstrap is idempotent: on every startup the entrypoint counts tables in $ZM_DB_NAME via information_schema; if any exist it skips initialization, and only when the count is zero does it create the database/user/grants as root (using MYSQL_ROOT_PASSWORD) and import /usr/share/zoneminder/db/zm_create.sql.",
