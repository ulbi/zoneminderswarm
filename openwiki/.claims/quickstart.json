    {
      "id": "claim_0fa85d57003f44daa73fd52bf00eaf89",
      "statement": "The ZoneMinder container entrypoint (entrypoint.sh) runs as PID 1 and executes sequential initialization phases: config seeding from /org/etc/zm, timezone setup, database wait-and-bootstrap, ZM_OPT_USE_EVENTNOTIFICATION enablement, zm.conf credential rewrite, MQTT configuration in zmeventnotification.ini, secrets.ini rewrite with portal URL and MLAPI_SECRET_KEY, then service startup.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L1-L128",
          "version": "repo-lines-v1:sha256:1d7b8edb05c2415b368854131c37c9c4786b6bff5da57df1ab73613558d868ea:"
        }
      ]
    },
    {
      "id": "claim_f60e919c82f54e3987cdf953eb5cc0e1",
      "statement": "Database initialization in entrypoint.sh waits for MariaDB on port 3306, checks table count, creates database/user/grants and imports zm_create.sql on first run, and enables ZM_OPT_USE_EVENTNOTIFICATION=1.",
      "evidence": [
