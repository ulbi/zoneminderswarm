    {
      "id": "claim_b72dc348a2c24f219c7be379160f1914",
      "statement": "The Dockerfile uses a two-stage build: an 'opencv_builder' stage (ubuntu:22.04) that compiles OpenCV 4.6.0 with contrib modules from source, and a final stage (ubuntu:22.04) that copies /usr/local from the builder and installs ZoneMinder, mlapi, and zmeventnotification.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L1-L55",
          "version": "repo-lines-v1:sha256:20c0a4d336df8888f0346180b84f31fdd4aa482b23288b94484806c57b62b2df:"
        },
        {
