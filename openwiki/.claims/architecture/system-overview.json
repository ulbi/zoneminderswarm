        }
      ]
    },
    {
      "id": "claim_db687c109fff4af5b481955d22a538d3",
      "statement": "docker-compose.yml hard-codes service discovery names into the ZoneMinder environment (ZM_DB_HOST: db, MQTT_HOST: eclipse-mosquitto, ZM_SERVER_HOST: zoneminder), so renaming any service requires updating these variables, and passes MQTT_USER/MQTT_PASSWORD to eclipse-mosquitto for broker authentication.",
      "evidence": [
