        },
        {
          "resource": "repo://entrypoint_mosquitto.sh#L5-L13",
          "version": "repo-lines-v1:sha256:485cdcabbff68918cabd3e897d70cad8d44e29d49302a4ee15159ce2dd47122c:"
        }
      ]
    },
    {
      "id": "claim_80edce6386984ef2a6229d8b623660b8",
      "statement": "Mosquitto persists message data in the mosquitto_data volume at /mosquitto/data with persistence enabled in its generated configuration.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L49-L50",
          "version": "repo-lines-v1:sha256:10b61f0d8b07ac3338e3b0b96121ee19d35e37201875897c754c96d859e7f5bd:"
        },
        {
