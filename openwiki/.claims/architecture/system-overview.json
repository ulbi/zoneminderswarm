        },
        {
          "resource": "repo://docker-compose.yml",
          "version": "repo-file-v1:sha256:c784a3df210ae4d63125ab022d859ea2ae57bf05f3dc385b0c4d642cfb9acf33"
        }
      ]
    },
    {
      "id": "claim_49b4f6f162c6434881f2cad03af2b609",
      "statement": "The Dockerfile backs up the pristine /etc/zm configuration to /org/etc/zm at build time, and entrypoint.sh copies those files into the zm_config volume on first start when the volume is empty; subsequent starts reuse the volume contents including manual edits.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L131-L135",
          "version": "repo-lines-v1:sha256:43d8233b2ce816483f66c77f057461537882c826bab145398e061c0478119093:"
