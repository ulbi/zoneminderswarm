        }
      ]
    },
    {
      "id": "claim_676f85a3799e43a08eb4aabf83717f48",
      "statement": "ZoneMinder uses a 400 MB tmpfs mount at /dev/shm for shared memory frame passing between capture, analysis, and streaming components.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L30-L32",
          "version": "repo-lines-v1:sha256:795a1fad3a46c71ab46957e7384f14b08e0c5465c98395f9f87052f5d7ac7985:"
        }
      ]
    },
    {
      "id": "claim_dfcda4b8410a47af8bcbe43d1443800f",
      "statement": "ZoneMinder persists configuration, cache, and face recognition data across four named volumes: zm_config (/etc/zm), zm_cache (/var/cache/zoneminder), known_faces, and unknown_faces.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L26-L29",
          "version": "repo-lines-v1:sha256:516644cab502e7d04f27c88d939f25ef78a8de0883ae39e0316e4cc6b2779243:"
        }
      ]
    },
    {
      "id": "claim_2ea00569b50040e58f34869c2b68f121",
      "statement": "Eclipse Mosquitto service builds from Dockerfile.mosquitto wrapping eclipse-mosquitto:latest and generates /mosquitto/config/mosquitto.conf at runtime via entrypoint_mosquitto.sh using MQTT_USER/MQTT_PASSWORD from environment. The override file maps host ports 1883 and 9001, but the generated config declares only a listener on 1883 — no WebSocket listener on 9001 is configured, so host connections to 9001 fail until one is added.",
      "evidence": [
        {
          "resource": "repo://Dockerfile.mosquitto",
          "version": "repo-file-v1:sha256:9fb771db0a1a9cd4e393a1bcb25e66046528b7476f64453dd7aac67765a16ef6"
        },
        {
          "resource": "repo://docker-compose.override.yml#L10-L14",
          "version": "repo-lines-v1:sha256:9d0758cf57e3354ef93b429c4b3616dce89f67e079e353a484f7ddd234d35020:"
        },
        {
