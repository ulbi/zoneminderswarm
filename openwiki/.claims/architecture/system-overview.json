    {
      "id": "claim_e8e49fe469c646d28a6f751ac15e24b2",
      "statement": "The stack uses six named Docker volumes (db_data, zm_config, zm_cache, known_faces, unknown_faces, mosquitto_data) declared in the base compose file with no bind mounts, surviving docker-compose down and remaining portable across hosts.",
