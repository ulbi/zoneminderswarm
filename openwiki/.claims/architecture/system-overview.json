  "claims": [
    {
      "id": "claim_c2e2f5e36a1042e884de8ffe1a59cbb2",
      "statement": "The stack comprises three services (MariaDB, ZoneMinder, Eclipse Mosquitto) orchestrated via two Docker Compose files: docker-compose.yml for base definitions and docker-compose.override.yml for build config and host port mappings.",
      "evidence": [
        {
          "resource": "repo://docker-compose.override.yml",
          "version": "repo-file-v1:sha256:7eecd1963b91cdb3d41ba9a43d6aea2203149b4a42492e2ec01b00456cdbc96b"
        },
        {
          "resource": "repo://docker-compose.yml",
          "version": "repo-file-v1:sha256:c784a3df210ae4d63125ab022d859ea2ae57bf05f3dc385b0c4d642cfb9acf33"
        }
      ]
    },
    {
      "id": "claim_5a3597e4536748f4943c0a252da73b58",
      "statement": "All three services share an attachable overlay network named zoneminder_network, enabling service discovery via Docker DNS (db, zoneminder, eclipse-mosquitto) and allowing external containers to join for debugging or integration.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L55-L58",
          "version": "repo-lines-v1:sha256:3478833c12360193645aa394016155b79cf7aa770e41d59ad959ee5e6e230877:"
        }
      ]
    },
    {
      "id": "claim_9df45e7a8d14451d883530d2f34e7cbc",
      "statement": "MariaDB (db service) runs mariadb:10.9, stores data in the db_data volume at /var/lib/mysql, and is accessible only within the overlay network on port 3306 — not published to the host.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L3-L14",
          "version": "repo-lines-v1:sha256:0a73c5f8f9706a2aae74945fabc4b12e0a53fd0b1a57da97826ad0c00129e189:"
        }
      ]
    },
    {
      "id": "claim_3a1517317434471eb2d093bd27d11e86",
      "statement": "ZoneMinder service builds from a multi-stage Dockerfile, exposes internal ports 80 (HTTP) and 9000 (WebSocket), mapped to host ports 7080 and 7000 respectively via the override file.",
      "evidence": [
        {
          "resource": "repo://docker-compose.override.yml#L3-L8",
          "version": "repo-lines-v1:sha256:3537b99c446eb42d9118e0a1d11d86a02b8ca075339ffba4ec17802500905e25:"
        },
        {
          "resource": "repo://docker-compose.yml#L16-L38",
