    {
      "id": "claim_369ccda05d0c4a58a36b41b4693f9c25",
      "statement": "The event flow follows: ZoneMinder event → zmeventnotification hook → HTTP POST to mlapi /detect with MLAPI_SECRET_KEY → mlapi runs YOLO object detection and face recognition → results returned to hook → hook publishes to MQTT topic zoneminder/<EID>.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L128-L131",
          "version": "repo-lines-v1:sha256:e1fa8153fb07ce093ccd309c14fb8e8bed085cefbb2ac7d99e14bffb023cf6c5:"
        },
