    {
      "id": "claim_9810ab4aba5e42578b0874ecf8c3fda8",
      "statement": "entrypoint.sh does NOT start mlapi or the zmeventnotification event server: both launch lines are commented out; only Apache and the ZoneMinder service are started, and the container is kept alive with 'tail -f /dev/null', so the inference and MQTT push legs of the pipeline must be started manually or externally.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L116-L120",
          "version": "repo-lines-v1:sha256:b4133708f5c7bbbf325a3b6d4231cc0526a44e881886672c652d74369d596539:"
