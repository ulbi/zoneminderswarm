    {
      "id": "claim_eabb38f6e093452e9f793cd66958f2d7",
      "statement": "At startup, entrypoint.sh rewrites /etc/zm/zmeventnotification.ini when MQTT_HOST is set (enabling the [mqtt] section with server/username/password from MQTT_* env vars, retain=yes, and disabling [ssl]) and rewrites /etc/zm/secrets.ini (portal URL to http://zoneminder/, ZM_USER, ZM_PASSWORD); it also sets ZM_OPT_USE_EVENTNOTIFICATION=1 in the ZoneMinder Config table.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L66-L69",
          "version": "repo-lines-v1:sha256:518a0d9a7dba99273908068c9965a63662769f8b83d184ff4361ab21be1606f9:"
