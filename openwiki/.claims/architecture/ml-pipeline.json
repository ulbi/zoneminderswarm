        }
      ]
    },
    {
      "id": "claim_23ba62720c9447e28dbb444c9c494c0f",
      "statement": "Because MLAPI_SECRET_KEY is regenerated on every container start, mlapi and the zmeventnotification hook must see the same secrets.ini (both live in the same container backed by the zm_config volume); if mlapi runs in a separate container, that container must share the zm_config volume or the key must be pinned and entrypoint regeneration disabled, or hook→mlapi authentication breaks after a restart.",
      "evidence": [
