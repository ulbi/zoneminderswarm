      "statement": "ZM_OPT_USE_EVENTNOTIFICATION is forced to '1' on every container start via UPDATE Config SET Value = '1' WHERE Name = 'ZM_OPT_USE_EVENTNOTIFICATION', enabling the event notification pipeline.",
