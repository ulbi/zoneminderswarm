        },
        {
          "resource": "repo://docker-compose.yml#L8-L8",
          "version": "repo-lines-v1:sha256:8bb31fecf3ece582c46c3e410303743037080baa04d24807a7071bdafed838b1:"
        }
      ]
    },
    {
      "id": "claim_d32198cb0ef24f60a48625e880c9c941",
      "statement": "MYSQL_ROOT_PASSWORD is injected into the ZoneMinder container's environment solely so entrypoint.sh can run the root-level CREATE DATABASE / CREATE USER / GRANT bootstrap against the db service; it is not needed for, or used in, any other database step.",
      "evidence": [
