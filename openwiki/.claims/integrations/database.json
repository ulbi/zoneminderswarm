    {
      "id": "claim_797e1a01cd4e45e78d81e7375914c299",
      "statement": "Runtime database configuration (/etc/zm/zm.conf) is rewritten at startup from environment variables (ZM_DB_HOST, ZM_DB_USER, ZM_DB_PASS, ZM_DB_NAME) using sed.",
