        }
      ]
    },
    {
      "id": "claim_69b82739cb924eb491c818a28dce8c46",
      "statement": "On first run (zero tables in ZM_DB_NAME), entrypoint.sh bootstraps the database by connecting as root to create the database and app user, then imports /usr/share/zoneminder/db/zm_create.sql as the app user.",
