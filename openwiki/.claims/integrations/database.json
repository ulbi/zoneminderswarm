    {
      "id": "claim_074871abe64e42668b06e678a22cdc9b",
      "statement": "The ZoneMinder container uses a root vs app user separation for MariaDB: root (MYSQL_ROOT_PASSWORD) performs one-time bootstrap (CREATE DATABASE, CREATE USER, GRANT), while the app user (ZM_DB_USER/ZM_DB_PASS) handles schema import and runtime operations.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L18-L28",
          "version": "repo-lines-v1:sha256:3501fd64377de1ff25e74c6235ba74f196a6c2f8d72f2e2096c7d70b12896262:"
        },
        {
