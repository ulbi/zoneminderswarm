  "claims": [
    {
      "id": "claim_884d0df45d6e4d18bc49ca4233ebed0a",
      "statement": "The zmeventnotification.ini MQTT section is enabled and configured at container startup via sed commands in entrypoint.sh when MQTT_HOST is defined.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L94-L104",
          "version": "repo-lines-v1:sha256:e31544fdff069f47ee22971bd1cd90dc00ba369ef782145a9fe91dc0f4ef9381:"
        }
      ]
    },
    {
      "id": "claim_5258f523ab044ff3a8ed262b0cfb8d72",
      "statement": "The entrypoint.sh uses sed range patterns to modify only the [mqtt] section, setting enable=yes, server, username, password, and retain=yes, while also disabling SSL in the [ssl] section.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L97-L104",
          "version": "repo-lines-v1:sha256:40301402b4ed4bbdc64bd3b6204358df3809606d61eac16e1f4c2e426dc2b3df:"
        }
      ]
    },
    {
      "id": "claim_6aba6b8adc08495e8bce8baba0c5bcfb",
      "statement": "The secrets.ini file is rewritten at startup to replace the portal URL from https://portal/ to http://zoneminder/, inject ZM_USER and ZM_PASSWORD from environment variables, and generate a new MLAPI_SECRET_KEY on every container start.",
      "evidence": [
        {
          "resource": "repo://entrypoint.sh#L106-L115",
          "version": "repo-lines-v1:sha256:db10250c452e0d5b3fecd105e29e21e12b653fcc11a0d9037e4d804dd404e9c3:"
        }
      ]
    },
    {
      "id": "claim_5fffab0d85644d67aba770d3cace15da",
      "statement": "The Mosquitto broker is configured via entrypoint_mosquitto.sh which generates mosquitto.conf with password authentication, persistence, and debug logging, and creates a password file from MQTT_USER/MQTT_PASSWORD environment variables.",
