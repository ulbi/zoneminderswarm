    },
    {
      "id": "claim_c7e1527ae6b244fb9f194f304642a282",
      "statement": "MQTT credentials are shared between the broker and the ZoneMinder container via the same MQTT_USER/MQTT_PASSWORD environment variables; the Mosquitto password file is rebuilt from them at broker start and they are written in cleartext into the volume-persisted zmeventnotification.ini, so both services must read the same .env values or authentication fails.",
      "evidence": [
        {
          "resource": "repo://docker-compose.yml#L37-L46",
          "version": "repo-lines-v1:sha256:69f3f89870d11cf2aee3f8736ca27fb4176efe3e70491eef37804e2fb6ce97ee:"
