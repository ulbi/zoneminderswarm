        }
      ]
    },
    {
      "id": "claim_c47666858ed64ff7bc0930977b932669",
      "statement": "Mosquitto persistence is enabled with persistence_location /mosquitto/data/ backed by the mosquitto_data named volume, so retained messages and subscriptions survive broker restarts as well as subscriber reconnects.",
